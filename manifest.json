{
  "manifest_version": 3,
  "name": "ConnectPilot",
  "version": "1.7.0",
  "description": "Draft personalized LinkedIn connection requests, referral asks, recruiter replies and follow-ups with AI. You review and send.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://connectpilot-api.onrender.com/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_title": "ConnectPilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connect-pilot.vercel.app/connect-extension*",
        "http://localhost:3000/connect-extension*"
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ]
}
